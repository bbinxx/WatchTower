# ============================================
# WatchTower Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- JWT ---
JWT_SECRET=your-jwt-secret-here

# --- Firebase (Client - used by frontend) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin (Server - service account JSON as single line) ---
FIREBASE_SERVICE_ACCOUNT=

# --- Email Notifications (SMTP) ---
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM_NAME=WatchTower
EMAIL_FROM_ADDRESS=alerts@example.com
EMAIL_RECIPIENTS=[]

# --- Telegram Notifications ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=[]
TELEGRAM_NOTIFY_DOWN=true
TELEGRAM_NOTIFY_UP=true
