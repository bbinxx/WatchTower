{
  "name": "watchtower",
  "version": "2.0.0",
  "description": "Uptime monitoring with cron-based architecture for free tier",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "cron": "node src/cron.js",
    "dev": "nodemon src/index.js",
    "dev:cron": "node src/cron.js",
    "version": "echo $npm_package_version",
    "release:patch": "npm version patch && git push origin main --tags",
    "release:minor": "npm version minor && git push origin main --tags",
    "release:major": "npm version major && git push origin main --tags",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.16.1",
    "chart.js": "^4.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.2.0",
    "moment": "^2.30.1",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "nodemailer": "^8.0.7",
    "ping": "^1.0.0",
    "tcp-ping": "^0.1.1",
    "winston": "^3.19.0"
  },
